{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Writingway 2",
  "version": "1.0.0",
  "identifier": "com.writingway.writingway2",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:8787/main.html",
    "beforeBuildCommand": "pnpm run tauri:prep",
    "frontendDist": "../dist-tauri"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Writingway 2",
        "url": "main.html",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
